<!DOCTYPE html>
html(lang="en" dir="ltr")
  head
    meta(charset='utf-8')
    meta(http-equiv='x-ua-compatible', content='ie=edge')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Marisa Vore Portfolio
    link(href='https://fonts.googleapis.com/css?family=Outfit:wght@300;400;500;600;700&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='/static/css/normalize.css')
    link(rel='stylesheet', href='/static/css/styles.css')

  body
    #my-info.sidebar
      .sidebar-info-box
        br
        .thumbnail-box
          img.thumbnail(src='/static/images/profile.jpg', alt='Portrait of Marisa Vore')
        .dev-intro-box

          //- Replace with your name
          h5 Marisa Vore

          //- Replace with description of who you are, what you do, and why you are so awesome
          p I'm a beginner female full-stack JavaScript developer building my skills through the Treehouse Techdegree program.

          //- Add path from your '/about' route handler to the href below
          a(href='/about') Learn More &rarr;

    .wrapper
      .header
        .header-info-box
          button#menu-icon.menu-icon(type='button' data-toggle='my-info')

          //- Replace with your name — this is for the mobile layout
          span Marisa Vore

      block content

  script(src='/static/js/script.js')