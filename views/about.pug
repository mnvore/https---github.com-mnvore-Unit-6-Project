extends layout.pug

block content

  nav.nav
    a(href='/')
      span &larr;
      |  Back

  article.portfolio-about
    .inner-wrapper.flex-row-wrap.two-col
      .about-intro-box.box

        //- Replace with your name
        h1 Marisa Vore

        //- Feel free to personalize the title below
        p Aspiring Associate Software Engingeer


        .about-bio

          //- Replace the boilerplate below with your best elevator pitch
          p MBA graduate in Entrepreneurship ans Innovation and current Software Engineering Apprentice at Intuit, building my technical foundation in full-stack JavaScript with the goal of converting full time. Experienced in product marketing, go-to-market strategy, and building 0→1 products, with a focus on bringing together product, marketing, and technology to build and launch products in an AI-driven future.

      .skills-contact-box.box
        h6 Skills

        //- Replace skills below with your own skills — at this point, you should be able to list as many as ten skills
        ul
          li HTML
          li CSS
          li JavaScript
          li Git and GitHub
          li VS Code
          li Accessibility
          li OOP
          li Fetch and Public APIs
          li Node.js
          li Express
          li Pug
          li Product Marketing
          li Product Design

        h6 Contact Info

        //- Replace with your own contact info - feel free to use fake information if you prefer
        ul
          li mvore@sandiego.edu

        //- Add URLs to the hrefs below to link to your social media accounts - feel free to use non-personal links to social media home pages if you prefer
        a.btn-link(href='https://www.linkedin.com/in/marisa-vore/') LinkedIn
        a.btn-link(href='https://github.com/mnvore') GitHub
        

    nav.nav
      a(href='/')
        span &larr;
        |  Back